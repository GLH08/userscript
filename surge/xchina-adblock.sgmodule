#!name=xchina.co 去广告
#!desc=复用站点 window.__ad_free，清顶飘/浮动/底飘/页内横幅等；Map Local 空化 core-state；拦 ExoClick/magsrv 与 /service/click。需 MITM 且系统信任 Surge CA。远程安装请用 raw.githubusercontent.com 链接。
#!category=Ad Block
#!requirement=CORE_VERSION>=20

[Rule]
DOMAIN-SUFFIX,magsrv.com,REJECT,pre-matching
DOMAIN-SUFFIX,exoclick.com,REJECT,pre-matching
DOMAIN-SUFFIX,exdynsrv.com,REJECT,pre-matching
DOMAIN-SUFFIX,exosrv.com,REJECT,pre-matching
DOMAIN-SUFFIX,realsrv.com,REJECT,pre-matching
DOMAIN,xchina.click,REJECT,pre-matching
DOMAIN-SUFFIX,xchina.click,REJECT,pre-matching
# DOMAIN-SUFFIX,googletagmanager.com,REJECT
# DOMAIN-SUFFIX,google-analytics.com,REJECT
# DOMAIN-SUFFIX,analytics.google.com,REJECT

[URL Rewrite]
^https?://([^/]+\.)?xchina\.click/(upload|prepare)(_|\?|/|$) _ reject
^https?://[^/]*xchina\.(co|online|work|app|click)/service/click(_|\?|/|$) _ reject
^https?://(a|s|ads|syndication)\.magsrv\.com/ _ reject
^https?://([^/]+\.)?(exoclick|exdynsrv|exosrv|realsrv)\.com/ _ reject

[Map Local]
^https?://([^/]+\.)?xchina\.(co|online|work|app)/service/assets/core-state\.js data-type=text data="window.__CORE_STATE__={\"meta\":{\"generated_at\":0},\"auto_closed\":{},\"ads\":[],\"zones\":{},\"packages\":{}};" header="Content-Type:application/javascript; charset=utf-8"

[Header Rewrite]
http-response ^https?://([^/]+\.)?xchina\.(co|online|work)/ header-del Delegate-CH

[Body Rewrite]
http-response ^https?://([^/]+\.)?xchina\.(co|online|work)/(?!service/|scripts/|css/|images/|plugins/)([^?\s]*)$ (?i)<head([^>]*)> <head$1><script>window.__ad_free=true;</script>

[Script]
xchina-adblock = type=http-response,pattern=^https?://([^/]+\.)?xchina\.(co|online|work)/(?!service/|scripts/|css/|images/|plugins/)([^?\s]*)$,requires-body=1,max-size=2097152,script-path=https://raw.githubusercontent.com/GLH08/userscript/refs/heads/main/surge/xchina-adblock.js,timeout=5

[MITM]
hostname = %APPEND% xchina.co, *.xchina.co, xchina.online, *.xchina.online, xchina.work, *.xchina.work, xchina.app, *.xchina.app, xchina.click, *.xchina.click, a.magsrv.com, s.magsrv.com, ads.magsrv.com, syndication.magsrv.com
h2 = true
auto-quic-block = true
